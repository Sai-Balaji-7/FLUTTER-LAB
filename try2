import 'package:flutter/material.dart';

void main() {
  runApp(
    MaterialApp(
      home: EnableDisable(),
    ),
  );
}

class EnableDisable extends StatefulWidget {

  @override
  State<EnableDisable> createState() {
    return _EnableDisableState();
  }

}

class _EnableDisableState extends State<EnableDisable> {

  bool enable = true;

  @override
  Widget build(BuildContext context) {
    return Scaffold(

      appBar: AppBar(
        title: Text("Enable Disable"),
      ),

      body: Center(
        child: Container(
          width: 250,
          height: 200,
          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [

              ElevatedButton(
                onPressed: enable ? () {} : null,
                child: Text("Click Me"),
              ),

              SizedBox(height: 20),

              ElevatedButton(
                onPressed: () {
                  setState(() {
                    enable = true;
                  });
                },
                child: Text("Enable"),
              ),

              SizedBox(height: 10),

              ElevatedButton(
                onPressed: () {
                  setState(() {
                    enable = false;
                  });
                },
                child: Text("Disable"),
              ),

            ],
          ),
        ),
      ),
    );
  }
}