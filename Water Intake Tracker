import 'dart:convert';
import 'package:flutter/material.dart';
import 'package:shared_preferences/shared_preferences.dart';

void main() {
  runApp(MaterialApp(
    debugShowCheckedModeBanner: false,
    home: WaterTracker(),
  ));
}

class WaterTracker extends StatefulWidget {
  @override
  State<WaterTracker> createState() => _WaterTrackerState();
}

class _WaterTrackerState extends State<WaterTracker> {
  int goal = 2000;
  int total = 0;
  int entries = 0;

  List<int> waterEntries = [];

  @override
  void initState() {
    super.initState();
    loadData();
  }

  Future<void> loadData() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();

    String today = DateTime.now().toString().substring(0, 10);
    String savedDate = prefs.getString("date") ?? "";

    if (savedDate != today) {
      await prefs.setString("date", today);
      await prefs.setString("entries", jsonEncode([]));
    }

    String data = prefs.getString("entries") ?? "[]";

    List<dynamic> savedEntries = jsonDecode(data);

    setState(() {
      waterEntries = savedEntries.cast<int>();
      total = waterEntries.fold(0, (sum, value) => sum + value);
      entries = waterEntries.length;
    });
  }

  Future<void> saveData() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();

    await prefs.setString(
      "entries",
      jsonEncode(waterEntries),
    );

    String today = DateTime.now().toString().substring(0, 10);
    await prefs.setString("date", today);
  }

  Future<void> addWater(int amount) async {
    setState(() {
      waterEntries.add(amount);
      total += amount;
      entries++;
    });

    await saveData();
  }

  Future<void> resetWater() async {
    SharedPreferences prefs = await SharedPreferences.getInstance();

    setState(() {
      waterEntries.clear();
      total = 0;
      entries = 0;
    });

    await prefs.setString("entries", jsonEncode([]));
  }

  void showResetDialog() {
    showDialog(
      context: context,
      builder: (context) {
        return AlertDialog(
          title: Text("Reset Water Intake?"),
          content: Text(
            "Are you sure you want to reset today's water intake?",
          ),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.pop(context);
              },
              child: Text("CANCEL"),
            ),
            ElevatedButton(
              onPressed: () {
                Navigator.pop(context);
                resetWater();
              },
              child: Text("RESET"),
            ),
          ],
        );
      },
    );
  }

  @override
  Widget build(BuildContext context) {
    int remaining = goal - total;

    if (remaining < 0) {
      remaining = 0;
    }

    double percentage = (total / goal) * 100;

    if (percentage > 100) {
      percentage = 100;
    }

    return Scaffold(
      backgroundColor: Colors.blue.shade50,

      appBar: AppBar(
        title: Text("Smart Water Tracker"),
        centerTitle: true,
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,

        actions: [
          IconButton(
            onPressed: showResetDialog,
            icon: Icon(Icons.refresh),
          ),
        ],
      ),

      body: SingleChildScrollView(
        padding: EdgeInsets.all(20),

        child: Column(
          children: [

            Icon(
              Icons.water_drop,
              size: 80,
              color: Colors.blue,
            ),

            SizedBox(height: 10),

            Text(
              "Daily Hydration Goal",
              style: TextStyle(
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),

            SizedBox(height: 5),

            Text(
              "$goal mL",
              style: TextStyle(
                fontSize: 30,
                fontWeight: FontWeight.bold,
                color: Colors.blue,
              ),
            ),

            SizedBox(height: 25),

            Card(
              elevation: 4,
              child: Padding(
                padding: EdgeInsets.all(20),

                child: Column(
                  children: [

                    Text(
                      "$total mL",
                      style: TextStyle(
                        fontSize: 32,
                        fontWeight: FontWeight.bold,
                        color: Colors.blue,
                      ),
                    ),

                    Text(
                      "Water Consumed",
                      style: TextStyle(
                        fontSize: 16,
                      ),
                    ),

                    SizedBox(height: 20),

                    LinearProgressIndicator(
                      value: percentage / 100,
                      minHeight: 12,
                      backgroundColor: Colors.grey.shade300,
                      color: Colors.blue,
                    ),

                    SizedBox(height: 10),

                    Text(
                      "${percentage.toStringAsFixed(0)}% Completed",
                      style: TextStyle(
                        fontSize: 18,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ],
                ),
              ),
            ),

            SizedBox(height: 20),

            Row(
              children: [

                Expanded(
                  child: Card(
                    child: Padding(
                      padding: EdgeInsets.all(15),

                      child: Column(
                        children: [
                          Icon(
                            Icons.water_drop,
                            color: Colors.blue,
                          ),

                          SizedBox(height: 8),

                          Text(
                            "$remaining mL",
                            style: TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),

                          Text("Remaining"),
                        ],
                      ),
                    ),
                  ),
                ),

                Expanded(
                  child: Card(
                    child: Padding(
                      padding: EdgeInsets.all(15),

                      child: Column(
                        children: [
                          Icon(
                            Icons.format_list_numbered,
                            color: Colors.green,
                          ),

                          SizedBox(height: 8),

                          Text(
                            "$entries",
                            style: TextStyle(
                              fontSize: 20,
                              fontWeight: FontWeight.bold,
                            ),
                          ),

                          Text("Entries"),
                        ],
                      ),
                    ),
                  ),
                ),
              ],
            ),

            SizedBox(height: 20),

            SizedBox(
              width: double.infinity,
              height: 50,

              child: ElevatedButton.icon(
                onPressed: () async {
                  int? amount = await Navigator.push(
                    context,
                    MaterialPageRoute(
                      builder: (context) => AddWater(),
                    ),
                  );

                  if (amount != null) {
                    addWater(amount);
                  }
                },

                icon: Icon(Icons.add),

                label: Text(
                  "ADD WATER",
                  style: TextStyle(fontSize: 17),
                ),
              ),
            ),

            SizedBox(height: 15),

            SizedBox(
              width: double.infinity,
              height: 50,

              child: OutlinedButton.icon(
                onPressed: showResetDialog,

                icon: Icon(Icons.delete),

                label: Text(
                  "RESET TODAY",
                  style: TextStyle(fontSize: 16),
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}


class AddWater extends StatefulWidget {
  @override
  State<AddWater> createState() => _AddWaterState();
}


class _AddWaterState extends State<AddWater> {

  final formKey = GlobalKey<FormState>();

  TextEditingController water = TextEditingController();

  @override
  Widget build(BuildContext context) {

    return Scaffold(
      appBar: AppBar(
        title: Text("Add Water"),
        backgroundColor: Colors.blue,
        foregroundColor: Colors.white,
      ),

      body: Padding(
        padding: EdgeInsets.all(20),

        child: Form(
          key: formKey,

          child: Column(
            mainAxisAlignment: MainAxisAlignment.center,

            children: [

              Icon(
                Icons.water_drop,
                size: 80,
                color: Colors.blue,
              ),

              SizedBox(height: 20),

              Text(
                "Enter Water Intake",
                style: TextStyle(
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),

              SizedBox(height: 25),

              TextFormField(
                controller: water,

                keyboardType: TextInputType.number,

                decoration: InputDecoration(
                  labelText: "Water Amount (mL)",
                  hintText: "Example: 500",
                  prefixIcon: Icon(Icons.local_drink),
                  border: OutlineInputBorder(),
                ),

                validator: (value) {

                  if (value == null || value.isEmpty) {
                    return "Please enter water amount";
                  }

                  int? amount = int.tryParse(value);

                  if (amount == null) {
                    return "Enter a valid number";
                  }

                  if (amount <= 0) {
                    return "Water amount must be greater than zero";
                  }

                  return null;
                },
              ),

              SizedBox(height: 20),

              SizedBox(
                width: double.infinity,
                height: 50,

                child: ElevatedButton(
                  onPressed: () {

                    if (formKey.currentState!.validate()) {

                      int amount = int.parse(water.text);

                      Navigator.pop(context, amount);
                    }
                  },

                  child: Text(
                    "ADD WATER",
                    style: TextStyle(fontSize: 17),
                  ),
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}